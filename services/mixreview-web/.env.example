VITE_APP_ORIGIN=https://mixreview.kingzbreadent.com
VITE_API_BASE_URL=

# Shared secret that the admin frontend sends as: Authorization: Bearer <key>
# Must match the ADMIN_API_KEY set in the Railway environment for the API service.
# Leave blank for local development (auth is bypassed on the server when unset in dev).
VITE_ADMIN_API_KEY=
